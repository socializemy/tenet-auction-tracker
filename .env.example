# Copy this file to .env and fill in real values.
# .env is gitignored and should NEVER be committed.

# Google Street View Static API key
# Get one at https://console.cloud.google.com/apis/credentials
GOOGLE_STREET_VIEW_API_KEY=your_key_here

# ScraperAPI key — used to fetch Zillow/Realtor.com listing photos through a
# residential proxy that bypasses PerimeterX/Cloudflare bot detection.
# Get one at https://www.scraperapi.com (5,000 free credits/month)
SCRAPERAPI_KEY=your_key_here
